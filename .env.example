# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (links del portal del huésped)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/* (Vercel Cron manda "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=cambiame

# Claude API (console.anthropic.com → API Keys): asistente del huésped y lectura del DNI
ANTHROPIC_API_KEY=
